// Prisma schema file for ShikshaSetu
// Using standard Prisma with plain JavaScript (CommonJS)

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ============================================================================
// Enums
// ============================================================================

enum Role {
  STUDENT
  ADMIN
}

enum Category {
  GEN
  OBC
  SC
  ST
  EWS
  MBC
  TFWS
  PWD
}

enum SenderType {
  STUDENT
  ASSISTANT
}

// ============================================================================
// Core User Model (Authentication & Roles)
// ============================================================================

model User {
  id           Int             @id @default(autoincrement())
  name         String
  email        String          @unique
  password     String
  role         Role            @default(STUDENT)
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt

  // Relationships
  profile      StudentProfile?
  chatSessions ChatSession[]

  @@index([email])
  @@index([role])
}

// ============================================================================
// Student Profile (Contact, Academics & Admission Preferences)
// ============================================================================

model StudentProfile {
  id                    Int       @id @default(autoincrement())
  userId                Int       @unique
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  // Personal & Contact Information
  fullName              String?
  phoneNumber           String?
  alternatePhone        String?
  dateOfBirth           DateTime?
  gender                String?
  address               String?
  district              String?
  city                  String?
  state                 String?   @default("Rajasthan")
  pincode               String?
  isRajasthanDomicile   Boolean   @default(true)

  // Academic Details
  currentEducationLevel String?
  instituteName         String?
  courseOrStream        String?
  passingYear           Int?
  percentageOrCgpa      Float?
  qualifyingExam        String?
  tenthPercentage       Float?
  twelfthPercentage     Float?
  diplomaPercentage     Float?
  examRank              Int?
  examRollNumber        String?

  // Category & Reservation Preferences
  category              Category  @default(GEN)
  subCategory           String?

  // Course & College Preferences
  preferredCourse       String?
  preferredLocation     String?
  preferredCollegeType  String?

  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@index([userId])
  @@index([examRank])
  @@index([category])
  @@index([preferredLocation])
}

// ============================================================================
// Chatbot Conversations & Messages
// ============================================================================

model ChatSession {
  id        String        @id @default(uuid())
  userId    Int
  user      User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  title     String        @default("New Conversation")
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt

  messages  ChatMessage[]

  @@index([userId])
  @@index([createdAt])
}

model ChatMessage {
  id         Int         @id @default(autoincrement())
  sessionId  String
  session    ChatSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  senderType SenderType  @default(STUDENT)
  content    String      @db.Text
  sources    Json?       // Structured citation metadata
  createdAt  DateTime    @default(now())

  @@index([sessionId])
  @@index([createdAt])
}

// ============================================================================
// Colleges & Cutoffs (Department of Technical Education Rajasthan)
// ============================================================================

model College {
  id              Int               @id @default(autoincrement())
  name            String
  code            String            @unique
  type            String            @default("GOVERNMENT") // GOVERNMENT, PRIVATE, AIDED
  district        String?
  city            String?
  location        String            @default("Rajasthan")
  state           String            @default("Rajasthan")
  address         String?
  website         String?
  contactEmail    String?
  contactPhone    String?
  establishedYear Int?
  isActive        Boolean           @default(true)
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt

  branches        Branch[]
  admissionCutoffs AdmissionCutoff[]
  cutoffs         CollegeCutoff[]

  @@index([code])
  @@index([location])
  @@index([district])
  @@index([type])
  @@index([isActive])
}

model Branch {
  id            Int               @id @default(autoincrement())
  name          String
  code          String
  durationYears Int               @default(3)
  seats         Int               @default(60)
  collegeId     Int
  college       College           @relation(fields: [collegeId], references: [id], onDelete: Cascade)
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt

  cutoffs       AdmissionCutoff[]

  @@unique([collegeId, code])
}

model AdmissionCutoff {
  id          Int      @id @default(autoincrement())
  collegeId   Int
  college     College  @relation(fields: [collegeId], references: [id], onDelete: Cascade)
  branchId    Int
  branch      Branch   @relation(fields: [branchId], references: [id], onDelete: Cascade)
  year        Int
  category    String
  cutoffMarks Float?
  cutoffRank  Int?
  round       Int      @default(1)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([collegeId, branchId, year, category, round])
}

model CollegeCutoff {
  id            Int      @id @default(autoincrement())
  collegeId     Int
  college       College  @relation(fields: [collegeId], references: [id], onDelete: Cascade)
  courseName    String
  category      Category
  admissionYear Int
  openingRank   Int
  closingRank   Int
  round         Int      @default(1)
  source        String
  sourceYear    Int
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@unique([collegeId, courseName, category, admissionYear, round])
  @@index([collegeId])
  @@index([courseName])
  @@index([category])
  @@index([admissionYear])
  @@index([closingRank])
}
