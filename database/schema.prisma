// Prisma schema file for ShikshaSetu
// Using standard Prisma with plain JavaScript (CommonJS)

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id        Int             @id @default(autoincrement())
  name      String
  email     String          @unique
  password  String
  role      String          @default("STUDENT")
  createdAt DateTime        @default(now())
  updatedAt DateTime        @updatedAt
  profile   StudentProfile?
}

model StudentProfile {
  id                    Int       @id @default(autoincrement())
  userId                Int       @unique
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  dateOfBirth           DateTime?
  gender                String?
  phoneNumber           String?
  state                 String?   @default("Rajasthan")
  district              String?
  city                  String?
  currentEducationLevel String?
  instituteName         String?
  courseOrStream        String?
  passingYear           Int?
  percentageOrCgpa      Float?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt
}

// -------------------------------------------------------------
// CP06: College & Branch Models
// Department of Technical Education, Government of Rajasthan
// -------------------------------------------------------------

model College {
  id           Int      @id @default(autoincrement())
  name         String   // College Name e.g. "Government Polytechnic College, Jaipur"
  code         String   @unique // Official DTE College Code e.g. "GPC-JPR"
  type         String   @default("GOVERNMENT") // GOVERNMENT, PRIVATE, AIDED
  district     String   // Rajasthan District e.g. "Jaipur", "Jodhpur", "Kota"
  city         String   // City name
  address      String?  // Full street address
  website      String?  // Official college website
  contactEmail String?  // Contact email for admissions/helpdesk
  contactPhone String?  // Contact telephone / mobile
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  // 1-to-Many Relationship: One College offers Many Branches
  branches     Branch[]

  // 1-to-Many Relationship: One College has Many Cutoff records
  cutoffs      AdmissionCutoff[]
}

model Branch {
  id            Int      @id @default(autoincrement())
  name          String   // Branch Name e.g. "Computer Science & Engineering"
  code          String   // Branch Code e.g. "CSE", "ME", "CE", "EE"
  durationYears Int      @default(3) // Duration in years (3 for Polytechnic Diploma)
  seats         Int      @default(60) // Sanctioned seat intake capacity
  collegeId     Int      // Foreign key referencing College.id
  college       College  @relation(fields: [collegeId], references: [id], onDelete: Cascade)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  // 1-to-Many Relationship: One Branch has Many Cutoff records
  cutoffs       AdmissionCutoff[]

  // Enforces that a college cannot offer duplicate branches with the same code
  @@unique([collegeId, code])
}

// -------------------------------------------------------------
// CP11: Admission & Cutoff Model
// Department of Technical Education, Government of Rajasthan
// -------------------------------------------------------------

model AdmissionCutoff {
  id          Int      @id @default(autoincrement())
  collegeId   Int                                        // Foreign key → College
  college     College  @relation(fields: [collegeId], references: [id], onDelete: Cascade)
  branchId    Int                                        // Foreign key → Branch
  branch      Branch   @relation(fields: [branchId], references: [id], onDelete: Cascade)
  year        Int                                        // Admission year e.g. 2024
  category    String                                     // GENERAL, OBC, SC, ST, EWS, MBC, SBC
  cutoffMarks Float?                                     // Cutoff percentage/marks (optional)
  cutoffRank  Int?                                       // Cutoff rank (optional)
  round       Int      @default(1)                       // Counseling round number (1, 2, 3...)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // One college+branch cannot have two cutoffs for the same year, category and round
  @@unique([collegeId, branchId, year, category, round])
}
