# Server Configuration
PORT=5001

# ----- PostgreSQL (Neon) -----
# Pooled connection used by the Node.js app / @prisma/client
DATABASE_URL="postgresql://username:password@localhost:5432/shiksha_setu"

# Direct connection used by Prisma migrations (Neon direct endpoint)
DIRECT_URL="postgresql://username:password@localhost:5432/shiksha_setu"

# JWT Secret for Token Signing (minimum 32 characters recommended)
JWT_SECRET="your_long_random_jwt_secret_key"

# Python FastAPI AI Service URL
# Development default: http://localhost:8000 (used automatically when this variable is missing)
# Production: Set to the deployed AI service URL (required — AI features return 503 if missing)
AI_SERVICE_URL="http://localhost:8000"

# Authorized Frontend Origin for CORS (e.g. Vite dev or production URL)
FRONTEND_URL="http://localhost:5173"
